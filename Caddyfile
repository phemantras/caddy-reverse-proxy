# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this could in some cases cause issues if left enabled
	# runtime logs
	log {
		format json # set runtime log format to json mode 
	}
	# server options
	servers {
		trusted_proxies static private_ranges # trust railway's proxy
	}
}

(lb_settings) {
	lb_policy round_robin
	lb_retries 100
	lb_try_duration 10s
	lb_try_interval 250ms
}

(passive_health_checks) {
	fail_duration 60s
	max_fails 300
	unhealthy_latency 5s
	unhealthy_request_count 200
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT} {

  log {
    format json
  }

  # 🟢 Alle API-Routen (inkl. /api und /socket etc.)
  handle /api/* {
    reverse_proxy {
      dynamic a {
        name {$BACKEND_DOMAIN}
        port {$BACKEND_PORT}
        refresh 1s
        versions ipv6
      }
      import lb_settings
      import passive_health_checks
      header_up Host {upstream_hostport}
    }
  }

  handle_path /socket/* {
    reverse_proxy {
      dynamic a {
        name {$BACKEND_DOMAIN}
        port {$BACKEND_PORT}
        refresh 1s
        versions ipv6
      }
      import lb_settings
      import passive_health_checks
      header_up Host {upstream_hostport}
    }
  }

  # 🟢 Optional: alles andere geht an das Frontend
  handle {
    reverse_proxy {
      dynamic a {
        name {$FRONTEND_DOMAIN}
        port {$FRONTEND_PORT}
        refresh 1s
        versions ipv6
      }
      import lb_settings
      import passive_health_checks
      header_up Host {upstream_hostport}
    }
  }
}
